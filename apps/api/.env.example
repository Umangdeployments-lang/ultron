# ============================================
# Ultron API — Production Environment
# Copy to your hosting platform (Railway) variables
# ============================================

# PostgreSQL (Railway managed Postgres)
DATABASE_URL="postgresql://user:password@host:port/db?schema=public"

# Redis (Railway managed Redis)
REDIS_HOST="host"
REDIS_PORT=6379
REDIS_ENABLED="true"

# API Server
PORT=4000

# Comma-separated list of allowed CORS origins (your Vercel URLs)
CORS_ORIGINS="https://your-app.vercel.app,http://localhost:3000"

# Encryption key for storing BYOK API keys (AES-256-GCM)
# 64 hex chars = 32 bytes. Generate with: openssl rand -hex 32
# IMPORTANT: Keep this stable across restarts — existing keys won't decrypt if it changes!
ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"

# Platform LLM keys (used when user selects "platform" key mode)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email — Resend or SMTP
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ultron <no-reply@yourdomain.com>"

# Approvals email base URL — must be reachable public URL (your Vercel app)
APP_BASE_URL="https://your-app.vercel.app"

# Slack (optional)
SLACK_BOT_TOKEN=""