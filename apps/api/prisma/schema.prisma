// ============================================
// Ultranomous Database Schema
// Multi-tenant, multi-plan architecture
// ============================================

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ---------- Tenant ----------
model Tenant {
    id        String    @id @default(cuid())
    name      String
    slug      String    @unique
    plan      PlanTier  @default(free)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    users      User[]
    workflows  Workflow[]
    apiKeys    ApiKey[]
    executions Execution[]
    workflowRecords WorkflowRecord[]
}

enum PlanTier {
    free
    starter
    pro
    business
    enterprise
}

// ---------- User ----------
model User {
    id           String   @id @default(cuid())
    email        String   @unique
    name         String?
    passwordHash String?
    role         UserRole @default(owner)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    tenantId String
    tenant   Tenant  @relation(fields: [tenantId], references: [id])

    approvals Approval[]  @relation("ApprovalDecisions")
}

enum UserRole {
    owner
    admin
    member
    viewer
}

// ---------- Workflow ----------
model Workflow {
    id          String        @id @default(cuid())
    name        String
    description String?
    // Graph JSON: { nodes, edges, version }
    definition  Json
    status      WorkflowStatus @default(draft)
    version     Int           @default(1)
    // Public path after /hooks/ for webhook-triggered workflows
    hookPath    String?       @unique
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    tenantId String
    tenant   Tenant      @relation(fields: [tenantId], references: [id])
    versions WorkflowVersion[]
    executions Execution[]

    @@index([tenantId, status])
}

enum WorkflowStatus {
    draft
    active
    paused
    archived
}

// ---------- Immutable version history ----------
model WorkflowVersion {
    id            String    @id @default(cuid())
    workflowId    String
    workflow      Workflow  @relation(fields: [workflowId], references: [id])
    version       Int
    definition    Json
    createdAt     DateTime  @default(now())
    publishedBy   String?
    // User id or system
    changeNote    String?
    executions    Execution[]

    @@unique([workflowId, version])
}

// ---------- Execution (one run of a workflow) ----------
model Execution {
    id          String          @id @default(cuid())
    workflowId  String
    workflow    Workflow        @relation(fields: [workflowId], references: [id])
    workflowVersionId String?
    workflowVersion WorkflowVersion? @relation(fields: [workflowVersionId], references: [id])
    version     Int
    status      ExecutionStatus @default(queued)
    input       Json
    output      Json?
    steps       Json           @default("[]")
    error       String?
    estimatedCostUsd Decimal?   @db.Decimal(10, 6)
    startedAt   DateTime        @default(now())
    finishedAt  DateTime?
    createdAt   DateTime        @default(now())

    tenantId String
    tenant   Tenant    @relation(fields: [tenantId], references: [id])
    approvals Approval[]

    @@index([workflowId, createdAt])
    @@index([tenantId, status])
}

enum ExecutionStatus {
    queued
    running
    waiting_approval
    succeeded
    failed
    cancelled
    timed_out
}

// ---------- Approval request (human-in-the-loop) ----------
model Approval {
    id          String   @id @default(cuid())
    executionId String
    execution   Execution @relation(fields: [executionId], references: [id])
    nodeId      String
    message     String
    status      ApprovalStatus @default(pending)
    token       String   @unique
    createdAt   DateTime @default(now())
    decidedAt   DateTime?
    decidedBy   String?

    // Who approved/rejected
    reviewer    User?    @relation("ApprovalDecisions", fields: [decidedBy], references: [id])
}

enum ApprovalStatus {
    pending
    approved
    rejected
}

// ---------- Workflow Data Store (Database action) ----------
model WorkflowRecord {
    id           String   @id @default(cuid())
    tenantId     String
    tenant       Tenant   @relation(fields: [tenantId], references: [id])
    workflowId   String?
    table        String
    data         Json
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([tenantId, table])
}

// ---------- API Keys (BYOK model) ----------
model ApiKey {
    id          String      @id @default(cuid())
    tenantId    String
    tenant      Tenant      @relation(fields: [tenantId], references: [id])
    name        String
    provider    KeyProvider
    // Encrypted with AES-256-GCM; ciphertext never stored in plaintext
    keyCipher   String
    keyIv       String
    keyTag      String
    keyHash     String      @unique
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    @@index([tenantId, provider])
}

enum KeyProvider {
    gemini
    openai
    anthropic
    custom
}